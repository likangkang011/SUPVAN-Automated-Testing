# 忽略.idea文件夹（核心规则）
.idea/
# 忽略Python字节码缓存文件夹（核心规则）
__pycache__/

# 忽略单独的.pyc字节码文件（防止个别未存入__pycache__的.pyc文件被提交）
*.pyc
*.pyo
*.pyd

# 忽略测试运行产物（截图 / 日志 / 失败现场 / HTML 报告 / 参数改写备份）
logs/*.log
logs/*.png
logs/screenshots/
logs/failure_artifacts/
logs/param_backups/
reports/*.html

# 忽略本地工作数据
.workbuddy/
